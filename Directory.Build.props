<Project>

  <!--
    Build-Ausgabe (bin/obj und das cargo-Zielverzeichnis) liegt außerhalb des Repos: X: ist eine SMB-Freigabe, dort
    bleiben gerade ausgeführte EXEs gern gesperrt und cargo ist langsam. Überschreibbar über die
    Umgebungsvariable/Property NexusArtifactsRoot.
  -->
  <PropertyGroup>
    <NexusArtifactsRoot Condition="'$(NexusArtifactsRoot)' == '' and '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\NexusSSH.build</NexusArtifactsRoot>
    <ArtifactsPath Condition="'$(NexusArtifactsRoot)' != ''">$(NexusArtifactsRoot)\artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Product>NexusSSH</Product>
    <Version>0.2.0</Version>

    <!-- Gemeinsame Windows-Zielplattform für alle Projekte, die WinRT-APIs nutzen -->
    <NexusWindowsTargetFramework>net10.0-windows10.0.26100.0</NexusWindowsTargetFramework>
    <NexusMinWindowsVersion>10.0.19041.0</NexusMinWindowsVersion>
  </PropertyGroup>

</Project>
