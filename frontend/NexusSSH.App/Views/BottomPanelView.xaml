<?xml version="1.0" encoding="utf-8"?>
<!--  Unterer Bereich (Spec §7): Output | Transfers | Problems | Search  -->
<UserControl
    x:Class="NexusSSH.App.Views.BottomPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:NexusSSH.App"
    xmlns:core="using:NexusSSH.Core"
    xmlns:loc="using:NexusSSH.App.Localization"
    xmlns:settings="using:NexusSSH.Core.Settings"
    xmlns:vm="using:NexusSSH.Core.ViewModels">

    <Grid Style="{StaticResource CardStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar
                x:Name="Tabs"
                Margin="4,0,0,0"
                AutomationProperties.Name="{loc:Loc Key=BottomPanelName}"
                SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="OutputTab" Text="{loc:Loc Key=Output}" />
                <SelectorBarItem
                    x:Name="TransfersTab"
                    IsSelected="True"
                    Text="{loc:Loc Key=Transfers}" />
                <SelectorBarItem x:Name="ProblemsTab" Text="{x:Bind Shell.ProblemsTitle, Mode=OneWay}" />
                <SelectorBarItem x:Name="SearchTab" Text="{loc:Loc Key=Search}" />
                <SelectorBarItem x:Name="HistoryTab" Text="{loc:Loc Key=History}" />
                <SelectorBarItem x:Name="FollowTab" Text="{loc:Loc Key=Follow}" />
            </SelectorBar>

            <!--  Aufräumen: je nach Reiter die erledigten Transfers oder die Probleme  -->
            <StackPanel
                Grid.Column="1"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <!--  Nur bei den Transfers, und nur wenn es etwas anzuhalten oder fortzusetzen gibt  -->
                <Button
                    x:Name="PauseAllButton"
                    AutomationProperties.Name="{loc:Loc Key=TransferPauseAll}"
                    Click="OnPauseAllClicked"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=TransferPauseAll}"
                    Visibility="Collapsed">
                    <FontIcon FontSize="14" Glyph="&#xE769;" />
                </Button>
                <Button
                    x:Name="ResumeAllButton"
                    AutomationProperties.Name="{loc:Loc Key=TransferResumeAll}"
                    Click="OnResumeAllClicked"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=TransferResumeAll}"
                    Visibility="Collapsed">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button
                    x:Name="ClearButton"
                    Click="OnClearClicked"
                    Style="{StaticResource IconButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE894;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Output: Protokoll der App  -->
        <ListView
            x:Name="OutputPane"
            Grid.Row="1"
            Padding="0,0,0,6"
            AutomationProperties.Name="{loc:Loc Key=Output}"
            ItemsSource="{x:Bind Shell.Output}"
            SelectionMode="None"
            Visibility="Collapsed">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="22" />
                    <Setter Property="Padding" Value="16,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LogEntry">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind core:Format.ClockTime(Time)}" />
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Text="{x:Bind Text}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Transfers; Spalten wie in der Zeilenvorlage  -->
        <Grid x:Name="TransfersPane" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                Padding="12,4,12,6"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="2*" MinWidth="120" />
                    <ColumnDefinition Width="*" MinWidth="90" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource ColumnHeaderStyle}"
                    Text="{loc:Loc Key=ColumnFile}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource ColumnHeaderStyle}"
                    Text="{loc:Loc Key=ColumnServer}" />
                <TextBlock
                    Grid.Column="3"
                    Style="{StaticResource ColumnHeaderStyle}"
                    Text="{loc:Loc Key=ColumnStatus}" />
            </Grid>
            <ListView
                Grid.Row="1"
                Padding="0,2,0,6"
                AutomationProperties.Name="{loc:Loc Key=Transfers}"
                ItemContainerStyle="{StaticResource CompactListItemStyle}"
                ItemsSource="{x:Bind Shell.Transfers.Items}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TransferItemViewModel">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="2*" MinWidth="120" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind app:Ui.TransferGlyph(IsUpload)}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind FileName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Server}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StatusText, Mode=OneWay}" />

                            <!--  Fortschritt, darunter übertragene Menge bzw. der Grund eines Fehlers  -->
                            <StackPanel
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <ProgressBar
                                    AutomationProperties.Name="{x:Bind FileName}"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay}"
                                    Value="{x:Bind ProgressPercent, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DetailText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind DetailText, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="5"
                                Width="28"
                                Height="28"
                                AutomationProperties.Name="{x:Bind app:Ui.CancelTransferName(FileName)}"
                                Click="OnCancelTransferClicked"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{loc:Loc Key=CancelTransfer}"
                                Visibility="{x:Bind CanCancel, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                            <!--  Gescheitert oder abgebrochen: noch einmal versuchen  -->
                            <Button
                                Grid.Column="5"
                                Width="28"
                                Height="28"
                                AutomationProperties.Name="{x:Bind app:Ui.RetryTransferName(FileName)}"
                                Click="OnRetryTransferClicked"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{loc:Loc Key=RetryTransfer}"
                                Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            </Button>
                            <!--  Läuft oder wartet: anhalten, in der Warteschlange umstellen  -->
                            <Button
                                Grid.Column="6"
                                Width="28"
                                Height="28"
                                AutomationProperties.Name="{x:Bind app:Ui.MoreName(FileName)}"
                                Click="OnTransferMoreClicked"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{loc:Loc Key=MoreActions}"
                                Visibility="{x:Bind CanCancel, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE712;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  Verlauf: beendete Verbindungen, die jüngste zuerst – nur wann, wie lange und wie sie endete  -->
        <Grid
            x:Name="HistoryPane"
            Grid.Row="1"
            Visibility="Collapsed">
            <TextBlock
                x:Name="NoHistoryText"
                Margin="20,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{loc:Loc Key=NoHistory}" />
            <ListView
                x:Name="HistoryList"
                Padding="0,2,0,6"
                AutomationProperties.Name="{loc:Loc Key=History}"
                ItemContainerStyle="{StaticResource CompactListItemStyle}"
                ItemsSource="{x:Bind Shell.History}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="settings:ConnectionRecord">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind core:Format.DateAndTime(Started)}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind Server}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Address}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind core:Format.Duration(Seconds)}" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind End}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  Problems: Warnungen und Fehler aus dem Protokoll  -->
        <Grid
            x:Name="ProblemsPane"
            Grid.Row="1"
            Visibility="Collapsed">
            <TextBlock
                x:Name="NoProblemsText"
                Margin="20,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{loc:Loc Key=NoProblems}" />
            <ListView
                x:Name="ProblemsList"
                Padding="0,2,0,6"
                AutomationProperties.Name="{loc:Loc Key=Problems}"
                ItemContainerStyle="{StaticResource CompactListItemStyle}"
                ItemsSource="{x:Bind Shell.Problems}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntry">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{x:Bind app:Ui.SeverityBrush(IsError)}"
                                Glyph="{x:Bind app:Ui.SeverityGlyph(IsError)}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind core:Format.ClockTime(Time)}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Text}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  Search: Zeilen aus dem Verlauf aller Terminals, in denen der Suchtext vorkommt  -->
        <Grid
            x:Name="SearchPane"
            Grid.Row="1"
            RowSpacing="4"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,2,12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Gesucht wird beim Tippen, mit kurzer Pause; Enter sucht sofort  -->
                <TextBox
                    x:Name="SearchBox"
                    AutomationProperties.Name="{loc:Loc Key=SearchPlaceholder}"
                    IsSpellCheckEnabled="False"
                    KeyDown="OnSearchKeyDown"
                    PlaceholderText="{loc:Loc Key=SearchPlaceholder}"
                    TextChanged="OnSearchTextChanged" />
                <ToggleButton
                    Grid.Column="1"
                    Height="32"
                    MinWidth="36"
                    Padding="6,0"
                    AutomationProperties.Name="{loc:Loc Key=FindMatchCase}"
                    Content="Aa"
                    IsChecked="{x:Bind Shell.Search.MatchCase, Mode=TwoWay}"
                    ToolTipService.ToolTip="{loc:Loc Key=FindMatchCase}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Shell.Search.ListSummary, Mode=OneWay}" />
            </Grid>
            <ListView
                Grid.Row="1"
                Padding="0,0,0,6"
                AutomationProperties.Name="{loc:Loc Key=Search}"
                IsItemClickEnabled="True"
                ItemClick="OnSearchHitClicked"
                ItemsSource="{x:Bind Shell.Search.Hits}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="Padding" Value="16,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchHit">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SessionTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <!--  Text aus der Ausgabe eines Servers: reiner Text, eine Zeile  -->
                            <TextBlock
                                Grid.Column="1"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Text="{x:Bind Text}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  Mitlesen: eine Datei des Servers wie mit tail -f, mit Filter und Hervorhebung. Der Text ist fremd und bleibt reiner Text.  -->
        <Grid
            x:Name="FollowPane"
            Grid.Row="1"
            RowSpacing="4"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="16,4,12,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        x:Name="FollowTitle"
                        Text="{x:Bind Shell.Follow.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="FollowStatus"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Shell.Follow.Status, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBox
                    x:Name="FollowFilterBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Loc Key=FollowFilter}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{loc:Loc Key=FollowFilter}"
                    Text="{x:Bind Shell.Follow.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    x:Name="FollowHighlightBox"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Loc Key=FollowHighlight}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{loc:Loc Key=FollowHighlight}"
                    Text="{x:Bind Shell.Follow.Highlight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <ToggleButton
                        x:Name="FollowPauseButton"
                        AutomationProperties.Name="{loc:Loc Key=FollowPause}"
                        IsChecked="{x:Bind Shell.Follow.IsPaused, Mode=TwoWay}"
                        ToolTipService.ToolTip="{loc:Loc Key=FollowPause}">
                        <FontIcon FontSize="14" Glyph="&#xE769;" />
                    </ToggleButton>
                    <Button
                        x:Name="FollowClearButton"
                        AutomationProperties.Name="{loc:Loc Key=FollowClear}"
                        Click="OnFollowClearClicked"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{loc:Loc Key=FollowClear}">
                        <FontIcon FontSize="14" Glyph="&#xE894;" />
                    </Button>
                    <Button
                        x:Name="FollowStopButton"
                        AutomationProperties.Name="{loc:Loc Key=FollowStop}"
                        Click="OnFollowStopClicked"
                        IsEnabled="{x:Bind Shell.Follow.IsFollowing, Mode=OneWay}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{loc:Loc Key=FollowStop}">
                        <FontIcon FontSize="14" Glyph="&#xE71A;" />
                    </Button>
                </StackPanel>
            </Grid>
            <ScrollViewer
                x:Name="FollowScroll"
                Grid.Row="1"
                Padding="16,0,12,6"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <RichTextBlock
                    x:Name="FollowText"
                    AutomationProperties.Name="{loc:Loc Key=Follow}"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    TextWrapping="NoWrap" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
