<?xml version="1.0" encoding="utf-8"?>
<!--
    Die linke Spalte der Ansicht „Zwei Spalten“: ein Ordner dieses Rechners. Hinein und hinaus, auswählen, zum
    Server hochladen – und das Ziel für das, was vom Server kommt. Geändert wird hier sonst nichts.
-->
<UserControl
    x:Class="NexusSSH.App.Views.LocalBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:NexusSSH.App"
    xmlns:controls="using:NexusSSH.App.Controls"
    xmlns:core="using:NexusSSH.Core"
    xmlns:loc="using:NexusSSH.App.Localization"
    xmlns:vm="using:NexusSSH.Core.ViewModels">

    <UserControl.Resources>
        <!--  Ein Menü für Rechtsklick und den Knopf „Weitere Optionen“  -->
        <MenuFlyout x:Key="EntryMenu" Opening="OnContextMenuOpening">
            <MenuFlyoutItem
                x:Name="UploadMenuItem"
                Click="OnUploadClicked"
                Text="{loc:Loc Key=LocalUpload}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE898;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                x:Name="RenameMenuItem"
                Click="OnRenameClicked"
                Text="{loc:Loc Key=Rename}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AC;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="DeleteMenuItem"
                Click="OnDeleteClicked"
                Text="{loc:Loc Key=Delete}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="CopyPathMenuItem" Click="OnCopyPathClicked" Text="{loc:Loc Key=CopyPath}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE71B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                x:Name="NewFolderMenuItem"
                Click="OnNewFolderClicked"
                Text="{loc:Loc Key=NewFolder}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8F4;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="SyncMenuItem"
                Click="OnSyncClicked"
                Text="{loc:Loc Key=LocalSync}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE895;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnRefreshClicked" Text="{loc:Loc Key=Refresh}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Style="{StaticResource CardStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Kopf: was diese Spalte ist  -->
        <Grid
            Padding="14,8,6,6"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                FontSize="15"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE7F8;" />
            <TextBlock
                Grid.Column="1"
                MinHeight="32"
                Padding="0,6,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{loc:Loc Key=LocalComputer}" />
        </Grid>

        <!--  Symbolzeile: Navigation links, die beiden Wege zwischen den Spalten rechts  -->
        <Grid Grid.Row="1" Padding="8,4,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    x:Name="UpButton"
                    AutomationProperties.Name="{loc:Loc Key=Up}"
                    Click="OnUpClicked"
                    IsEnabled="{x:Bind Local.CanGoUp, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=Up}">
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <Button
                    AutomationProperties.Name="{loc:Loc Key=Refresh}"
                    Click="OnRefreshClicked"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=Refresh}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="LocalNewFolderButton"
                    AutomationProperties.Name="{loc:Loc Key=NewFolder}"
                    Click="OnNewFolderClicked"
                    IsEnabled="{x:Bind Local.IsFolder, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=NewFolder}">
                    <FontIcon FontSize="14" Glyph="&#xE8F4;" />
                </Button>
                <Button
                    x:Name="LocalSyncButton"
                    AutomationProperties.Name="{loc:Loc Key=LocalSync}"
                    Click="OnSyncClicked"
                    IsEnabled="{x:Bind Local.IsFolder, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=LocalSync}">
                    <FontIcon FontSize="14" Glyph="&#xE895;" />
                </Button>
                <Button
                    x:Name="LocalMoreButton"
                    AutomationProperties.Name="{loc:Loc Key=MoreActions}"
                    Flyout="{StaticResource EntryMenu}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=MoreActions}">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    x:Name="DownloadHereButton"
                    AutomationProperties.Name="{loc:Loc Key=LocalDownload}"
                    Click="OnDownloadHereClicked"
                    ToolTipService.ToolTip="{loc:Loc Key=LocalDownload}">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <Button
                    x:Name="UploadButton"
                    AutomationProperties.Name="{loc:Loc Key=LocalUpload}"
                    Click="OnUploadClicked"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=LocalUpload}">
                    <FontIcon FontSize="14" Glyph="&#xE72A;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Pfad: Brotkrumen ab „Dieser Rechner“  -->
        <Grid
            Grid.Row="2"
            Padding="14,4,6,2"
            ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <BreadcrumbBar
                x:Name="Breadcrumbs"
                VerticalAlignment="Center"
                AutomationProperties.Name="{loc:Loc Key=LocalFiles}"
                ItemClicked="OnBreadcrumbClicked"
                ItemsSource="{x:Bind Local.Segments}">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="core:PathSegment">
                        <TextBlock Text="{x:Bind Name}" />
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
            <!--  Pfad eintippen: liegt über den Brotkrumen, Enter oder der Knopf wechselt, Esc verwirft  -->
            <TextBox
                x:Name="LocalPathBox"
                VerticalAlignment="Center"
                AutomationProperties.Name="{loc:Loc Key=LocalPath}"
                IsSpellCheckEnabled="False"
                KeyDown="OnPathBoxKeyDown"
                Visibility="Collapsed" />
            <Button
                x:Name="LocalPathButton"
                Grid.Column="1"
                AutomationProperties.Name="{loc:Loc Key=LocalPath}"
                Click="OnEditPathClicked"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{loc:Loc Key=LocalPath}">
                <FontIcon FontSize="14" Glyph="&#xE70F;" />
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="3"
            Margin="8,4,8,0"
            IsClosable="False"
            IsOpen="{x:Bind Local.HasError, Mode=OneWay}"
            Message="{x:Bind Local.Error, Mode=OneWay}"
            Severity="Error" />

        <!--  Spaltenköpfe wie in der Liste des Servers: Klick sortiert, Rechtsklick wählt die Spalten, Griff links zieht  -->
        <Border
            Grid.Row="4"
            Padding="12,0"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="0,1,0,1">
            <controls:FileColumnHeaders x:Name="ColumnHeaders" LeadWidth="16" Spacing="10" />
        </Border>

        <!--  Was vom Server hierher gezogen wird, landet im angezeigten Ordner; von hier lässt sich zum Server ziehen  -->
        <ListView
            x:Name="EntryList"
            Grid.Row="5"
            Padding="0,2,0,8"
            AutomationProperties.Name="{loc:Loc Key=LocalFiles}"
            CanDragItems="True"
            CharacterReceived="OnEntryCharacterReceived"
            ContextFlyout="{StaticResource EntryMenu}"
            DoubleTapped="OnEntryDoubleTapped"
            DragItemsStarting="OnDragItemsStarting"
            ItemContainerStyle="{StaticResource CompactListItemStyle}"
            ItemsSource="{x:Bind Local.Entries, Mode=OneWay}"
            KeyDown="OnEntryKeyDown"
            RightTapped="OnEntryRightTapped"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalEntry">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind app:Ui.LocalGlyph(IsDirectory, IsDrive)}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Text="{x:Bind DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <!--  Spalten wie in der Liste des Servers (Ui.LocalColumn…, die Zahl ist der Wert von FileColumn)  -->
                        <TextBlock
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            Width="{x:Bind app:Ui.LocalColumnWidth(1)}"
                            Tag="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind SizeText}"
                            TextAlignment="Right"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind app:Ui.LocalColumnVisibility(1)}" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="10,0,0,0"
                            Width="{x:Bind app:Ui.LocalColumnWidth(2)}"
                            Tag="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ModifiedText}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind app:Ui.LocalColumnVisibility(2)}" />
                        <TextBlock
                            Grid.Column="4"
                            Margin="10,0,0,0"
                            Width="{x:Bind app:Ui.LocalColumnWidth(6)}"
                            Tag="6"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind TypeText}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind app:Ui.LocalColumnVisibility(6)}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Mit deckendem Hintergrund, wie die Fußzeile der Serverliste: Eine sehr lange Liste liefe sonst hinein.  -->
        <Border Grid.Row="6" Background="{ThemeResource CardBackgroundBrush}">
            <TextBlock
                Padding="14,6,14,8"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Local.CountText, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>
