<?xml version="1.0" encoding="utf-8"?>
<!--
    Schlüssel – eine Seite der Startseite: die eigenen Schlüsseldateien ansehen (Art, Fingerabdruck, Kommentar),
    die Passphrase ändern und zwischen den Formaten von OpenSSH und PuTTY umwandeln. Gelesen wird ohne Passphrase;
    Namen und Kommentare kommen aus den Dateien und sind reiner Text.
-->
<UserControl
    x:Class="NexusSSH.App.Views.KeysView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:NexusSSH.App"
    xmlns:loc="using:NexusSSH.App.Localization"
    xmlns:models="using:NexusSSH.Core.Models">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid MaxWidth="820" HorizontalAlignment="Left" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                MinWidth="300"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{loc:Loc Key=KeysTitle}" />
            <!--  Die Dateien ändern sich auch außerhalb der App (ssh-keygen, PuTTYgen)  -->
            <Button
                x:Name="RefreshKeysButton"
                Grid.Column="1"
                Click="OnRefreshClicked"
                Content="{loc:Loc Key=KeyRefresh}" />
        </Grid>

        <TextBlock
            Grid.Row="1"
            MaxWidth="820"
            HorizontalAlignment="Left"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{loc:Loc Key=KeysHint}"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="NoKeysText"
            Grid.Row="2"
            Margin="0,12,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{loc:Loc Key=NoKeys}" />
        <ListView
            x:Name="KeysList"
            Grid.Row="2"
            MaxWidth="820"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{loc:Loc Key=KeysTitle}"
            ItemsSource="{x:Bind Shell.KeyFiles}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:KeyFile">
                    <Grid
                        MinWidth="560"
                        Padding="14,10,10,10"
                        Background="{ThemeResource RaisedBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        ColumnSpacing="12"
                        CornerRadius="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind app:Ui.KeySummary(Kind, Format, IsEncrypted)}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Fingerprint}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind app:Ui.VisibleIfText(Fingerprint)}" />
                            <!--  Aus der Datei .pub daneben, nicht aus dem Schlüssel selbst: Das soll niemand für geprüft halten  -->
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{loc:Loc Key=KeyUnchecked}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind app:Ui.VisibleIf(IsUnchecked)}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind app:Ui.KeyNote(Comment, UsedBy)}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind app:Ui.KeyNoteVisibility(Comment, UsedBy)}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Path}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                AutomationProperties.Name="{x:Bind app:Ui.KeyCopyName(Name)}"
                                Click="OnCopyPublicClicked"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{loc:Loc Key=KeyCopyPublic}"
                                Visibility="{x:Bind app:Ui.VisibleIfText(PublicKey)}">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{x:Bind app:Ui.KeyPassphraseName(Name)}"
                                Click="OnPassphraseClicked"
                                Content="{loc:Loc Key=KeyChangePassphrase}"
                                Tag="{x:Bind}" />
                            <Button
                                AutomationProperties.Name="{x:Bind app:Ui.KeyConvertName(Format, Name)}"
                                Click="OnConvertClicked"
                                Content="{x:Bind app:Ui.KeyConvertText(Format)}"
                                Tag="{x:Bind}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
