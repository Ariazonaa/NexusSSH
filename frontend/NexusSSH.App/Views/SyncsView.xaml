<?xml version="1.0" encoding="utf-8"?>
<!--  Gemerkte Abgleiche – eine Seite der Startseite: lokaler Ordner und Ordner am Server, mit einem Klick erneut abgleichen.  -->
<UserControl
    x:Class="NexusSSH.App.Views.SyncsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:NexusSSH.App"
    xmlns:loc="using:NexusSSH.App.Localization"
    xmlns:settings="using:NexusSSH.Core.Settings">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Loc Key=SyncsTitle}" />

        <TextBlock
            Grid.Row="1"
            MaxWidth="760"
            HorizontalAlignment="Left"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{loc:Loc Key=SyncsHint}"
            TextWrapping="Wrap" />

        <ListView
            x:Name="SyncList"
            Grid.Row="2"
            MaxWidth="760"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{loc:Loc Key=SyncsTitle}"
            ItemsSource="{x:Bind Shell.SavedSyncs, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="settings:SavedSync">
                    <Grid
                        MinWidth="520"
                        Padding="14,10,10,10"
                        Background="{ThemeResource RaisedBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        ColumnSpacing="8"
                        CornerRadius="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Summary}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind app:Ui.RunSyncName(Name)}"
                            Click="OnRunClicked"
                            Content="{loc:Loc Key=SyncRun}"
                            Style="{StaticResource AccentButtonStyle}"
                            Tag="{x:Bind}" />
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind app:Ui.RenameSyncName(Name)}"
                            Click="OnRenameClicked"
                            Content="{loc:Loc Key=Rename}"
                            Tag="{x:Bind}" />
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind app:Ui.DeleteSyncName(Name)}"
                            Click="OnDeleteClicked"
                            Content="{loc:Loc Key=Delete}"
                            Tag="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
