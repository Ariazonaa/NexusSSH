<?xml version="1.0" encoding="utf-8"?>
<!--
    Gespeicherte Befehle (Snippets) verwalten – eine Seite der Startseite. Links die Liste, nach Ordnern gegliedert
    (die erste Zeile eines Ordners trägt seinen Namen), rechts der gewählte Befehl samt Ordner. ↑ ↓ (auch Alt+Pfeil)
    verschieben ihn in seinem Ordner. Gespeichert wird bei jeder Änderung; einen Knopf dafür gibt es nicht.
-->
<UserControl
    x:Class="NexusSSH.App.Views.SnippetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:NexusSSH.App"
    xmlns:controls="using:NexusSSH.App.Controls"
    xmlns:loc="using:NexusSSH.App.Localization"
    xmlns:vm="using:NexusSSH.Core.ViewModels">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{loc:Loc Key=SnippetsTitle}" />
            <!--  Im Ordner nach oben und nach unten  -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="MoveUpButton"
                    AutomationProperties.AutomationId="SnippetMoveUp"
                    AutomationProperties.Name="{loc:Loc Key=SnippetMoveUp}"
                    Click="OnMoveUpClicked"
                    IsEnabled="{x:Bind Editor.CanMoveUp, Mode=OneWay}"
                    ToolTipService.ToolTip="{loc:Loc Key=SnippetMoveUp}">
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <Button
                    x:Name="MoveDownButton"
                    AutomationProperties.AutomationId="SnippetMoveDown"
                    AutomationProperties.Name="{loc:Loc Key=SnippetMoveDown}"
                    Click="OnMoveDownClicked"
                    IsEnabled="{x:Bind Editor.CanMoveDown, Mode=OneWay}"
                    ToolTipService.ToolTip="{loc:Loc Key=SnippetMoveDown}">
                    <FontIcon FontSize="14" Glyph="&#xE74B;" />
                </Button>
            </StackPanel>
            <Button
                x:Name="RemoveButton"
                Grid.Column="2"
                AutomationProperties.Name="{loc:Loc Key=SnippetRemove}"
                Click="OnRemoveClicked"
                IsEnabled="{x:Bind Editor.HasSelection, Mode=OneWay}"
                ToolTipService.ToolTip="{loc:Loc Key=SnippetRemove}">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="{loc:Loc Key=SnippetAdd}"
                Click="OnAddClicked"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{loc:Loc Key=SnippetAdd}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" MaxWidth="640" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="SnippetList"
                AutomationProperties.Name="{loc:Loc Key=SnippetsTitle}"
                Background="{ThemeResource RaisedBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ItemContainerStyle="{StaticResource CompactListItemStyle}"
                ItemsSource="{x:Bind Editor.Rows, Mode=OneWay}"
                PreviewKeyDown="OnListKeyDown"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SnippetRow">
                        <StackPanel>
                            <!--  Die erste Zeile eines Ordners trägt seinen Namen  -->
                            <StackPanel
                                Margin="0,6,0,4"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind HasHeading, Mode=OneWay}">
                                <controls:LineIcon
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource FolderIconBrush}"
                                    Kind="Folder"
                                    Size="13" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Text="{x:Bind Heading, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Margin="{x:Bind app:Ui.SnippetIndent(Folder), Mode=OneWay}"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Noch kein Befehl  -->
            <TextBlock
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{loc:Loc Key=SnippetsEmpty}"
                TextWrapping="Wrap"
                Visibility="{x:Bind app:Ui.CollapsedIf(Editor.HasSelection), Mode=OneWay}" />

            <Grid
                Grid.Column="1"
                RowSpacing="10"
                Visibility="{x:Bind Editor.HasSelection, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="320" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="NameBox"
                    Header="{loc:Loc Key=SnippetName}"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind Editor.Selected.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!--
                    Der Ordner: schlägt die vorhandenen vor, ein neuer Name legt einen an, leer heißt ohne. Er gilt erst
                    mit Enter, einem Vorschlag oder beim Verlassen des Feldes – sonst wanderte die Zeile links bei
                    jedem Buchstaben in einen anderen Ordner.
                -->
                <AutoSuggestBox
                    x:Name="FolderBox"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="SnippetFolderBox"
                    Header="{loc:Loc Key=SnippetFolder}"
                    LostFocus="OnFolderLostFocus"
                    PlaceholderText="{loc:Loc Key=SnippetNoFolder}"
                    QuerySubmitted="OnFolderSubmitted"
                    TextChanged="OnFolderTextChanged" />
                <!--  Der Befehl selbst: mehrere Zeilen sind erlaubt, jede wird wie mit Enter abgeschickt  -->
                <TextBox
                    Grid.Row="2"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{loc:Loc Key=SnippetText}"
                    FontFamily="Cascadia Mono, Consolas"
                    IsSpellCheckEnabled="False"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind Editor.Selected.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap">
                    <!--  Die Beschriftung behält die Schrift der Oberfläche; nur der Befehl steht in Festbreite  -->
                    <TextBox.Header>
                        <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="{loc:Loc Key=SnippetText}" />
                    </TextBox.Header>
                </TextBox>
                <CheckBox
                    Grid.Row="3"
                    Content="{loc:Loc Key=SnippetRun}"
                    IsChecked="{x:Bind Editor.Selected.Run, Mode=TwoWay}" />
                <TextBlock
                    Grid.Row="4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{loc:Loc Key=SnippetsHint}"
                    TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
