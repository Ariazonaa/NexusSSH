<?xml version="1.0" encoding="utf-8"?>
<!--  Passwort, Passphrase oder Fragen des Servers. Die Eingabefelder entstehen im Code – ihre Zahl steht erst zur Laufzeit fest.  -->
<ContentDialog
    x:Class="NexusSSH.App.Dialogs.SecretDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NexusSSH.App.Localization"
    CloseButtonText="{loc:Loc Key=Cancel}"
    DefaultButton="Primary"
    PrimaryButtonText="{loc:Loc Key=SecretSubmit}">

    <StackPanel Width="400" Spacing="12">
        <InfoBar
            x:Name="RetryWarning"
            IsClosable="False"
            IsOpen="True"
            Message="{loc:Loc Key=SecretWrong}"
            Severity="Warning"
            Visibility="Collapsed" />
        <TextBlock x:Name="Intro" TextWrapping="Wrap" />
        <TextBlock
            x:Name="Instructions"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <StackPanel x:Name="Fields" Spacing="10" />
        <CheckBox
            x:Name="SaveBox"
            Content="{loc:Loc Key=SecretSave}"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
