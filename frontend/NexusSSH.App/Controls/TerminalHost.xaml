<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NexusSSH.App.Controls.TerminalHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NexusSSH.App.Localization"
    IsTabStop="False">

    <Grid Background="{StaticResource TerminalBackgroundBrush}">
        <!--  Ein WebView für alle Sitzungen; die Seite schaltet zwischen den Terminals um  -->
        <WebView2
            x:Name="WebView"
            AutomationProperties.Name="{loc:Loc Key=SettingsTerminal}"
            DefaultBackgroundColor="{StaticResource TerminalBackground}" />

        <StackPanel
            x:Name="ErrorPanel"
            MaxWidth="520"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{loc:Loc Key=TerminalUnavailable}" />
            <TextBlock
                x:Name="ErrorDetail"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <!--  Nur wenn die WebView2-Laufzeit fehlt: der Weg zu ihr – eine feste Adresse bei Microsoft  -->
            <HyperlinkButton
                x:Name="GetWebViewLink"
                HorizontalAlignment="Center"
                Content="{loc:Loc Key=TerminalGetWebView}"
                NavigateUri="https://go.microsoft.com/fwlink/p/?LinkId=2124703"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
