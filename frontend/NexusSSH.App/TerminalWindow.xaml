<?xml version="1.0" encoding="utf-8"?>
<!--
    Das Terminal eines Tabs in einem eigenen Fenster: eine schmale Titelzeile mit Zustand und Name, darunter nur
    das Terminal. Die Sitzung gehört weiter dem Hauptfenster – dort stehen ihr Reiter, ihre Dateien, ihre Server-Info.
-->
<Window
    x:Class="NexusSSH.App.TerminalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:NexusSSH.App.Localization"
    Title="NexusSSH">

    <Grid x:Name="Root" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleRow" Height="40" Padding="14,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInsetColumn" Width="140" />
            </Grid.ColumnDefinitions>
            <Ellipse
                x:Name="StateDot"
                Width="8"
                Height="8"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="ReattachButton"
                Grid.Column="2"
                Height="28"
                Padding="10,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{loc:Loc Key=DetachedReattachTip}"
                Click="OnReattachClicked"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="{loc:Loc Key=DetachedReattachTip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE8A0;" />
                    <TextBlock FontSize="12" Text="{loc:Loc Key=DetachedReattach}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Wie im Hauptfenster hält das Terminal Abstand zum Rand: Ein WebView lässt sich nicht rund beschneiden  -->
        <Grid x:Name="TerminalArea" Grid.Row="1" Padding="6,0,6,6" />
    </Grid>
</Window>
